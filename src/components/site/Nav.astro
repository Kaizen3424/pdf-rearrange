---
import Logo from './Logo.astro';
import LanguagePicker from './LanguagePicker.astro';
import ThemeToggle from './ThemeToggle.astro';
import { defaultLocale, getDictionary, localePath, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);

const links = [
  { href: localePath('/#how-it-works', locale), label: t.nav.howItWorks },
  { href: localePath('/#features', locale), label: t.nav.features },
  { href: localePath('/#privacy', locale), label: t.nav.privacy },
  { href: localePath('/#faq', locale), label: t.nav.faq },
];
---

<header
  data-nav
  class="sticky top-0 z-40 material-thick border-b border-transparent transition-[border-color,box-shadow] duration-200 data-[scrolled=true]:border-hairline data-[scrolled=true]:elev-1 data-[open=true]:border-hairline"
>
  <nav class="container-page flex h-16 items-center justify-between gap-4" aria-label={t.nav.ariaLabel}>
    <a href={localePath('/', locale)} class="focus-ring rounded-md shrink-0">
      <Logo />
    </a>

    <ul class="hidden lg:flex items-center gap-7">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="inline-block py-1 text-body-sm-strong text-ink hover:text-ink-deep transition-colors focus-ring rounded-sm"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1.5 sm:gap-2.5">
      <div class="hidden lg:flex">
        <ThemeToggle locale={locale} />
      </div>
      <LanguagePicker locale={locale} variant="nav" />
      <a href={localePath('/#rearrange', locale)} class="btn btn-primary hidden sm:inline-flex">{t.nav.cta}</a>
      <button
        type="button"
        class="btn-icon tap-target lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-nav-toggle
      >
        <span class="sr-only">{t.nav.toggleMenu}</span>
        <svg
          data-icon-open
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          data-icon-close
          class="hidden"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" hidden class="lg:hidden border-t border-hairline max-h-[calc(100dvh-3.5rem)] overflow-y-auto overscroll-contain">
    <ul class="container-page py-4 space-y-1 pb-safe">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-md px-3 py-2.5 text-body-md-strong text-ink hover:bg-canvas-soft transition-colors focus-ring"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="flex items-center justify-between gap-3 rounded-md px-3 py-2.5">
        <span class="text-body-md-strong text-ink">{t.theme.ariaLabel}</span>
        <ThemeToggle locale={locale} />
      </li>
      <li class="pt-2">
        <a href={localePath('/#rearrange', locale)} class="btn btn-primary w-full">{t.nav.cta}</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLElement>('[data-nav-toggle]');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = toggle?.querySelector('[data-icon-open]');
  const iconClose = toggle?.querySelector('[data-icon-close]');

  const setScrolled = () => {
    if (header) header.dataset.scrolled = window.scrollY > 8 ? 'true' : 'false';
  };
  setScrolled();
  window.addEventListener('scroll', setScrolled, { passive: true });

  const setMenu = (open: boolean, restoreFocus = false) => {
    if (!menu || !toggle) return;
    menu.hidden = !open;
    if (header) header.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    menu.classList.remove('animate-menu-in');
    if (open) {
      void menu.offsetWidth; // restart the entrance
      menu.classList.add('animate-menu-in');
    }
    document.documentElement.classList.toggle('overflow-hidden', open);
    if (restoreFocus) toggle.focus();
  };

  toggle?.addEventListener('click', () => setMenu(!!menu?.hidden));
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => setMenu(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.hidden) setMenu(false, true);
  });
</script>
