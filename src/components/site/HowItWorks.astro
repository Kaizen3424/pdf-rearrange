---
import Icon from './Icon.astro';
import { defaultLocale, getDictionary, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);

const steps = t.howItWorks.steps.map((step, index) => ({
  icon: ['upload', 'move', 'download'][index],
  ...step,
}));
---

<section id="how-it-works" class="scroll-mt-24 bg-canvas">
  <div class="container-page py-16 md:py-24">
    <div class="max-w-2xl">
      <h2 class="text-display-sm font-semibold">{t.howItWorks.heading}</h2>
      <p class="mt-3 text-body-lg text-body">
        {t.howItWorks.sub}
      </p>
    </div>

    <ol class="mt-10 grid gap-6 md:grid-cols-3">
      {
        steps.map((step, index) => (
          <li class="relative rounded-xl bg-canvas-soft p-6 md:p-7">
            <div class="flex items-center justify-between">
              <span class="flex size-11 items-center justify-center rounded-md bg-ink text-primary">
                <Icon name={step.icon} size={22} />
              </span>
              <span
                class="font-black text-display-md text-ink/10"
                aria-hidden="true"
              >
                {index + 1}
              </span>
            </div>
            <h3 class="mt-5 text-display-xs font-semibold">{step.title}</h3>
            <p class="mt-2 text-body-md text-body">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
