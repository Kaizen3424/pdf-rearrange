---
import Icon from './Icon.astro';

const steps = [
  {
    icon: 'upload',
    title: 'Add your PDF',
    text: 'Drop a file anywhere on the page, click to browse, or paste one in. Add more PDFs anytime — they merge into a single document.',
  },
  {
    icon: 'move',
    title: 'Arrange your pages',
    text: 'Drag thumbnails into any order. Rotate, duplicate, delete, or select many pages at once — with full undo if you change your mind.',
  },
  {
    icon: 'download',
    title: 'Download instantly',
    text: 'Your PDF is rebuilt right on your device and downloads in seconds. No watermark, no sign-up, no waiting in line.',
  },
];
---

<section id="how-it-works" class="scroll-mt-24 bg-canvas">
  <div class="container-page py-16 md:py-24">
    <div class="max-w-2xl">
      <h2 class="text-display-sm font-semibold">How to rearrange PDF pages</h2>
      <p class="mt-3 text-body-lg text-body">
        Three steps, zero uploads. Your file is processed locally from start to finish.
      </p>
    </div>

    <ol class="mt-10 grid gap-6 md:grid-cols-3">
      {
        steps.map((step, index) => (
          <li class="relative rounded-xl bg-canvas-soft p-6 md:p-7">
            <div class="flex items-center justify-between">
              <span class="flex size-11 items-center justify-center rounded-md bg-ink text-primary">
                <Icon name={step.icon} size={22} />
              </span>
              <span
                class="font-black text-display-md text-ink/10"
                aria-hidden="true"
              >
                {index + 1}
              </span>
            </div>
            <h3 class="mt-5 text-display-xs font-semibold">{step.title}</h3>
            <p class="mt-2 text-body-md text-body">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
