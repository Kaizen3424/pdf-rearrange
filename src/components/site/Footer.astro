---
import Logo from './Logo.astro';
import LanguagePicker from './LanguagePicker.astro';
import { defaultLocale, getDictionary, localePath, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();

const columns = [
  {
    title: t.footer.colTool,
    ariaLabel: t.footer.colTool,
    links: [
      { href: localePath('/#rearrange', locale), label: t.footer.rearrangePages },
      { href: localePath('/#how-it-works', locale), label: t.footer.howItWorks },
      { href: localePath('/how-to-organize-pdf-pages', locale), label: t.footer.guide },
      { href: localePath('/#faq', locale), label: t.footer.faq },
    ],
  },
  {
    title: t.footer.colCompany,
    ariaLabel: t.footer.colCompany,
    links: [
      { href: localePath('/about', locale), label: t.footer.about },
      { href: localePath('/contact', locale), label: t.footer.contact },
    ],
  },
  {
    title: t.footer.colLegal,
    ariaLabel: t.footer.colLegal,
    links: [
      { href: localePath('/privacy', locale), label: t.footer.privacyPolicy },
      { href: localePath('/terms', locale), label: t.footer.termsOfService },
    ],
  },
];
---

<footer class="bg-ink text-canvas-soft">
  <div class="container-page py-12 md:py-16 grid gap-10 md:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr_1fr]">
    <div>
      <a href={localePath('/', locale)} class="inline-block focus-ring rounded-md">
        <Logo variant="light" />
      </a>
      <p class="mt-4 text-body-sm text-canvas-soft/70 max-w-xs">
        {t.footer.tagline}
      </p>
    </div>

    {
      columns.map((column) => (
        <nav aria-label={column.ariaLabel}>
          <h2 class="text-body-sm-strong text-primary mb-3">{column.title}</h2>
          <ul class="space-y-2.5 text-body-sm">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-canvas-soft/80 hover:text-primary transition-colors focus-ring rounded-sm"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <LanguagePicker locale={locale} variant="footer" />
  </div>

  <div class="border-t border-canvas-soft/15">
    <div
      class="container-page py-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-caption text-canvas-soft/60"
    >
      <p>{t.footer.copyright(year)}</p>
      <p>{t.footer.noAds}</p>
    </div>
  </div>
</footer>
