---
import Logo from './Logo.astro';
import LanguagePicker from './LanguagePicker.astro';
import { defaultLocale, getDictionary, localePath, type Locale } from '../../i18n/utils';
import { getToolsWithContent } from '../../content/tools';
import { comparisonSlugs, getComparison, isComparisonLive } from '../../content/comparisons';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();
const tools = getToolsWithContent(locale);

/**
 * Comparison links for this locale, filtered by the registry.
 *
 * The filter is what makes English-first staging safe here. These pages ship in
 * one locale at a time, so listing all three on every locale would put three
 * dead internal links in the footer of seven languages — the same class of bug
 * the language picker had. `isComparisonLive` requires both content and a
 * registry entry, so a locale only ever links to pages that exist in it.
 */
const comparisons = comparisonSlugs
  .filter((slug) => isComparisonLive(slug, locale))
  .map((slug) => {
    const page = getComparison(slug, locale);
    return page ? { href: localePath(`/${page.slug}`, locale), label: page.breadcrumb } : null;
  })
  .filter((link): link is { href: string; label: string } => link !== null);

const columns = [
  {
    title: t.footer.colTool,
    ariaLabel: t.footer.colTool,
    links: [
      { href: localePath('/#rearrange', locale), label: t.footer.rearrangePages },
      { href: localePath('/tools', locale), label: t.nav.tools },
      ...tools.map(({ tool, content }) => ({
        href: localePath(`/${tool.slug}`, locale),
        label: content.breadcrumb,
      })),
    ],
  },
  ...(comparisons.length > 0
    ? [
        {
          title: t.footer.colAlternatives,
          ariaLabel: t.footer.colAlternatives,
          links: comparisons,
        },
      ]
    : []),
  {
    title: t.footer.colCompany,
    ariaLabel: t.footer.colCompany,
    links: [
      { href: localePath('/about', locale), label: t.footer.about },
      { href: localePath('/contact', locale), label: t.footer.contact },
    ],
  },
  {
    title: t.footer.colLegal,
    ariaLabel: t.footer.colLegal,
    links: [
      { href: localePath('/privacy', locale), label: t.footer.privacyPolicy },
      { href: localePath('/terms', locale), label: t.footer.termsOfService },
    ],
  },
];
---

<footer class="bg-solid text-on-solid">
  <div class="container-page py-12 md:py-16 grid gap-10 md:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr_1fr_1fr]">
    <div>
      <a href={localePath('/', locale)} class="inline-block focus-ring rounded-md">
        <Logo variant="light" />
      </a>
      <p class="mt-4 text-body-sm text-on-solid/70 max-w-xs">
        {t.footer.tagline}
      </p>
    </div>

    {
      columns.map((column) => (
        <nav aria-label={column.ariaLabel}>
          <h2 class="text-body-sm-strong text-primary mb-3">{column.title}</h2>
          <ul class="space-y-2.5 text-body-sm">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-block py-0.5 text-on-solid/80 hover:text-primary transition-colors focus-ring rounded-sm"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <LanguagePicker locale={locale} variant="footer" />
  </div>

  <div class="border-t border-on-solid/15">
    <div
      class="container-page py-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-caption text-on-solid/60"
    >
      <p>{t.footer.copyright(year)}</p>
      <p>{t.footer.noAds}</p>
    </div>
  </div>
</footer>
