---
import Icon from './Icon.astro';
---

<section id="rearrange" class="scroll-mt-24 relative" data-hero>
  <div class="container-page pt-10 pb-14 md:pt-16 md:pb-20">
    <div
      class="hero-grid mx-auto max-w-6xl text-center lg:grid lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-14 lg:text-left"
    >
      <div data-hero-copy>
        <p class="chip">
          <Icon name="shield-check" size={16} />
          100% private — files never leave your browser
        </p>
        <h1 class="mt-5 font-black text-display-md sm:text-display-md xl:text-display-xl">
          Rearrange PDF pages, right in your browser.
        </h1>
        <p class="mt-5 text-body-lg text-body max-w-xl mx-auto lg:mx-0">
          Drag and drop to reorder pages, rotate, duplicate or delete them — then download
          instantly. Free, unlimited and completely private.
        </p>
        <ul
          class="mt-6 flex flex-wrap justify-center lg:justify-start gap-x-5 gap-y-2 text-body-sm text-body"
        >
          <li class="inline-flex items-center gap-1.5">
            <Icon name="check" size={16} class="text-positive" /> No sign-up
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Icon name="check" size={16} class="text-positive" /> No page limits
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Icon name="check" size={16} class="text-positive" /> No watermark
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Icon name="check" size={16} class="text-positive" /> No file size caps
          </li>
        </ul>
      </div>

      <div class="mt-10 lg:mt-0 w-full" data-hero-tool>
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  [data-hero].is-active [data-hero-copy] {
    display: none;
  }
  [data-hero].is-active .hero-grid {
    grid-template-columns: 1fr;
  }
</style>

<script>
  const hero = document.querySelector('[data-hero]');
  window.addEventListener('organize:state', (event) => {
    const active = (event as CustomEvent).detail?.active === true;
    hero?.classList.toggle('is-active', active);
  });
</script>
