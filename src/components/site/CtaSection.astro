---
import Icon from './Icon.astro';
---

<section class="bg-canvas">
  <div class="container-page py-16 md:py-24 text-center">
    <h2 class="font-black text-display-md sm:text-display-lg">Fix your page order in seconds.</h2>
    <p class="mt-4 text-body-lg text-body max-w-xl mx-auto">
      No uploads. No limits. No sign-up. Just drag, drop and download.
    </p>
    <a href="/#rearrange" class="btn btn-primary mt-8">
      Rearrange a PDF now
      <Icon name="arrow-right" size={18} />
    </a>
  </div>
</section>
