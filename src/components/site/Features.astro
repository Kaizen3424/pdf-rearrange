---
import Icon from './Icon.astro';
import { defaultLocale, getDictionary, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);

const icons = ['shield-check', 'infinity', 'zap', 'undo-2', 'smartphone', 'file-check'];
const features = t.features.items.map((feature, index) => ({
  icon: icons[index] ?? 'check',
  ...feature,
  highlight: index === 0,
}));
---

<section id="features" class="scroll-mt-24 bg-canvas-soft">
  <div class="container-page py-16 md:py-24">
    <div class="max-w-2xl">
      <h2 class="text-display-sm font-semibold">{t.features.heading}</h2>
      <p class="mt-3 text-body-lg text-body">
        {t.features.sub}
      </p>
    </div>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <li
            class:list={[
              'rounded-xl p-6 md:p-7 h-full',
              feature.highlight ? 'bg-primary-pale' : 'bg-canvas',
            ]}
          >
            <span
              class:list={[
                'flex size-11 items-center justify-center rounded-md',
                feature.highlight ? 'bg-ink text-primary' : 'bg-canvas-soft text-ink',
              ]}
            >
              <Icon name={feature.icon} size={22} />
            </span>
            <h3 class="mt-5 text-display-xs font-semibold">{feature.title}</h3>
            <p class="mt-2 text-body-md text-body">{feature.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
