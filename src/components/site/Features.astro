---
import Icon from './Icon.astro';

const features = [
  {
    icon: 'shield-check',
    title: 'Private by design',
    text: 'Your PDF is processed entirely inside your browser. No uploads, no servers, no tracking — open your browser\u2019s network tab and verify it yourself.',
    highlight: true,
  },
  {
    icon: 'infinity',
    title: 'No limits, ever',
    text: 'No page caps, no file-size ceilings, no daily quotas. Reorder 10 pages or 1,000 — local processing means there is nothing to meter.',
    highlight: false,
  },
  {
    icon: 'zap',
    title: 'Instant results',
    text: 'There is no upload-and-wait round trip. Pages render and your new PDF is built on your device, so even large files feel immediate.',
    highlight: false,
  },
  {
    icon: 'undo-2',
    title: 'Undo anything',
    text: 'Full history with undo and redo (Ctrl+Z / Ctrl+Shift+Z), multi-select, and keyboard shortcuts. Experiment freely — nothing is permanent until you download.',
    highlight: false,
  },
  {
    icon: 'smartphone',
    title: 'Made for mobile too',
    text: 'Large tap targets, long-press to drag, and a thumb-friendly action bar. Rearranging pages on a phone shouldn\u2019t feel like a chore.',
    highlight: false,
  },
  {
    icon: 'file-check',
    title: 'Original quality preserved',
    text: 'Pages are copied byte-for-byte from your original PDF. Fonts, vectors, images and links stay exactly as they were — no re-compression.',
    highlight: false,
  },
];
---

<section id="features" class="scroll-mt-24 bg-canvas-soft">
  <div class="container-page py-16 md:py-24">
    <div class="max-w-2xl">
      <h2 class="text-display-sm font-semibold">Everything you need to organize a PDF</h2>
      <p class="mt-3 text-body-lg text-body">
        The page-reordering tools people already like — without the uploads, limits, ads or
        sign-ups they complain about.
      </p>
    </div>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <li
            class:list={[
              'rounded-xl p-6 md:p-7 h-full',
              feature.highlight ? 'bg-primary-pale' : 'bg-canvas',
            ]}
          >
            <span
              class:list={[
                'flex size-11 items-center justify-center rounded-md',
                feature.highlight ? 'bg-ink text-primary' : 'bg-canvas-soft text-ink',
              ]}
            >
              <Icon name={feature.icon} size={22} />
            </span>
            <h3 class="mt-5 text-display-xs font-semibold">{feature.title}</h3>
            <p class="mt-2 text-body-md text-body">{feature.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
