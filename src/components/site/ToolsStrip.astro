---
import Icon from './Icon.astro';
import { defaultLocale, getDictionary, localePath, type Locale } from '../../i18n/utils';
import { getToolsWithContent } from '../../content/tools';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
const tools = getToolsWithContent(locale);
---

{
  tools.length > 0 && (
    <section id="tools" class="scroll-mt-24 bg-canvas-soft border-y border-hairline">
      <div class="container-page py-16 md:py-20">
        <div class="max-w-2xl" data-reveal>
          <h2 class="text-display-sm font-semibold">{t.tools.h1}</h2>
          <p class="mt-3 text-body-lg text-body">{t.tools.intro}</p>
        </div>

        <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {tools.map(({ tool, content }, index) => (
            <li data-reveal style={`--reveal-delay:${index * 45}ms`}>
              <a
                href={localePath(`/${tool.slug}`, locale)}
                class="group flex items-center gap-3.5 rounded-xl bg-canvas p-4 transition-[transform,box-shadow] duration-200 ease-standard hover:-translate-y-0.5 hover:elev-2"
              >
                <span class="flex size-10 shrink-0 items-center justify-center rounded-md bg-solid text-primary">
                  <Icon name={tool.icon} size={20} />
                </span>
                <span class="min-w-0 grow">
                  <span class="block truncate text-body-md-strong text-ink">
                    {content.breadcrumb}
                  </span>
                  <span class="mt-0.5 block truncate text-caption text-mute">
                    {content.h1}
                  </span>
                </span>
                <Icon
                  name="chevron-right"
                  size={18}
                  class="shrink-0 text-mute transition-transform duration-200 ease-out-expo group-hover:translate-x-0.5"
                />
              </a>
            </li>
          ))}
        </ul>

        <p class="mt-8 text-body-md" data-reveal>
          <a
            href={localePath('/tools', locale)}
            class="inline-flex items-center gap-2 font-semibold underline underline-offset-2 transition-colors hover:text-ink focus-ring rounded-sm"
          >
            {t.tools.allInOneTitle}
            <Icon
              name="arrow-right"
              size={16}
              class="transition-transform duration-200 ease-out-expo"
            />
          </a>
        </p>
      </div>
    </section>
  )
}
