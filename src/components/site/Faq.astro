---
import Icon from './Icon.astro';
import { faqs } from '../../data/faqs';
---

<section id="faq" class="scroll-mt-24 bg-canvas-soft">
  <div class="container-page py-16 md:py-24">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-display-sm font-semibold text-center">Frequently asked questions</h2>
      <p class="mt-3 text-body-lg text-body text-center">
        Everything people usually want to know before rearranging their first PDF.
      </p>

      <div class="mt-10 space-y-3">
        {
          faqs.map((faq) => (
            <details class="group rounded-xl bg-canvas">
              <summary class="flex cursor-pointer items-center justify-between gap-4 rounded-xl p-5 text-body-md-strong text-ink list-none [&::-webkit-details-marker]:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">
                {faq.q}
                <Icon
                  name="chevron-down"
                  class="shrink-0 text-mute transition-transform duration-200 group-open:rotate-180"
                />
              </summary>
              <div class="px-5 pb-5 -mt-1 text-body-md text-body">{faq.a}</div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
