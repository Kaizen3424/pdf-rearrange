---
import FaqList from './FaqList.astro';
import { defaultLocale, getDictionary, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
---

<FaqList items={t.faq.items} heading={t.faq.heading} sub={t.faq.sub} id="faq" />
