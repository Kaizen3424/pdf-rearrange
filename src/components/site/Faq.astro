---
import Icon from './Icon.astro';
import { defaultLocale, getDictionary, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
---

<section id="faq" class="scroll-mt-24 bg-canvas-soft">
  <div class="container-page py-16 md:py-24">
    <div class="max-w-3xl mx-auto" data-reveal>
      <h2 class="text-display-sm font-semibold text-center">{t.faq.heading}</h2>
      <p class="mt-3 text-body-lg text-body text-center">
        {t.faq.sub}
      </p>

      <div class="mt-10 space-y-3">
        {
          t.faq.items.map((faq, index) => (
            <details
              class="group rounded-xl bg-canvas transition-[box-shadow,transform] duration-200 ease-standard open:elev-1 hover:elev-1"
              data-reveal
              style={`--reveal-delay:${index * 60}ms`}
            >
              <summary class="flex cursor-pointer items-center justify-between gap-4 rounded-xl p-5 text-body-md-strong text-ink list-none transition-colors duration-150 hover:bg-canvas-soft [&::-webkit-details-marker]:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">
                {faq.q}
                <Icon
                  name="chevron-down"
                  class="shrink-0 text-mute transition-transform duration-200 group-open:rotate-180"
                />
              </summary>
              <div class="px-5 pb-5 -mt-1 text-body-md text-body">{faq.a}</div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
