---
import RichText from '../RichText.astro';
import { defaultLocale, getDictionary, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = getDictionary(locale);
---

<section id="about" class="scroll-mt-24 bg-canvas">
  <div class="container-page py-16 md:py-24">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-display-sm font-semibold">{t.seoContent.h2}</h2>
      <p class="mt-4 text-body-lg text-body">
        <RichText text={t.seoContent.p1} locale={locale} />
      </p>
      <p class="mt-4 text-body-md text-body">
        <RichText text={t.seoContent.p2} locale={locale} />
      </p>

      <h3 class="mt-10 text-display-xs font-semibold">{t.seoContent.h3Merge}</h3>
      <p class="mt-3 text-body-md text-body">
        <RichText text={t.seoContent.pMerge} locale={locale} />
      </p>

      <h3 class="mt-10 text-display-xs font-semibold">{t.seoContent.h3Delete}</h3>
      <p class="mt-3 text-body-md text-body">
        <RichText text={t.seoContent.pDelete} locale={locale} />
      </p>

      <h3 class="mt-10 text-display-xs font-semibold">{t.seoContent.h3Steps}</h3>
      <p class="mt-3 text-body-md text-body">
        <RichText text={t.seoContent.pSteps} locale={locale} />
      </p>
      <div class="mt-5 rounded-xl bg-primary-pale p-6">
        <ol class="space-y-3 text-body-md text-body">
          {
            t.seoContent.steps.map((step, index) => (
              <li class="flex gap-3">
                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-solid text-caption font-bold text-primary">
                  {index + 1}
                </span>
                <span>
                  <RichText text={step} locale={locale} />
                </span>
              </li>
            ))
          }
        </ol>
      </div>
      <p class="mt-4 text-body-md text-body">
        <RichText text={t.seoContent.pStepsOutro} locale={locale} />
      </p>

      <h3 class="mt-10 text-display-xs font-semibold">{t.seoContent.h3Mobile}</h3>
      <p class="mt-3 text-body-md text-body">
        <RichText text={t.seoContent.pMobile} locale={locale} />
      </p>

      <h3 class="mt-10 text-display-xs font-semibold">{t.seoContent.h3Best}</h3>
      <p class="mt-3 text-body-md text-body">
        <RichText text={t.seoContent.pBest} locale={locale} />
      </p>
      <ul class="mt-4 space-y-4 text-body-md text-body">
        {
          t.seoContent.bestList.map((item) => (
            <li>
              <RichText text={item} locale={locale} />
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-body-md text-body">
        <RichText text={t.seoContent.pBestOutro} locale={locale} />
      </p>

      <h3 class="mt-10 text-display-xs font-semibold">{t.seoContent.h3Why}</h3>
      <p class="mt-3 text-body-md text-body">
        <RichText text={t.seoContent.pWhy} locale={locale} />
      </p>
    </div>
  </div>
</section>
