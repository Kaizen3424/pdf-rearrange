---
import Icon from './Icon.astro';

interface Props {
  code: string;
  heading: string;
  message: string;
  reload?: boolean;
  tryAgainLabel?: string;
  backToToolLabel?: string;
}

const {
  code,
  heading,
  message,
  reload = false,
  tryAgainLabel = 'Try again',
  backToToolLabel = 'Back to the tool',
} = Astro.props;
---

<section class="bg-canvas-soft">
  <div class="container-page py-20 md:py-28 text-center relative isolate" data-reveal>
    <div
      class="pointer-events-none absolute left-1/2 top-16 h-56 w-56 -translate-x-1/2 rounded-full bg-primary/25 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="relative">
      <p class="font-black text-display-xxl text-ink/10" aria-hidden="true">{code}</p>
      <h1 class="-mt-6 font-black text-display-md sm:text-display-lg">{heading}</h1>
      <p class="mt-4 text-body-lg text-body max-w-md mx-auto">{message}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        {reload && (
          <button type="button" class="btn btn-primary" data-error-reload>
            {tryAgainLabel}
            <Icon name="refresh-cw" size={18} />
          </button>
        )}
        <a
          href="/"
          class:list={['group', reload ? ['btn', 'btn-secondary'] : ['btn', 'btn-primary']]}
        >
          {backToToolLabel}
          <Icon name="arrow-right" size={18} class="transition-transform duration-200 ease-out-expo group-hover:translate-x-1" />
        </a>
      </div>
    </div>
  </div>
</section>

{reload && (
  <script>
    document.querySelector('[data-error-reload]')?.addEventListener('click', () => {
      window.location.reload();
    });
  </script>
)}
