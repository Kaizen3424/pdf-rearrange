---
import '@fontsource-variable/inter';
import jpFontCss from '@fontsource-variable/noto-sans-jp/index.css?url';
import krFontCss from '@fontsource-variable/noto-sans-kr/index.css?url';
import '../styles/global.css';
import { defaultLocale, getAlternates, getDictionary, localeMeta, localePath, type Locale } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  /** Logical (locale-independent) path used for canonical + hreflang URLs, e.g. `/about`. */
  canonicalPath?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  keywords?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  locale?: Locale;
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  ogType = 'website',
  keywords,
  jsonLd,
  locale = defaultLocale,
} = Astro.props;

const meta = localeMeta[locale];
const dict = getDictionary(locale);

const cjkFontCss = locale === 'ja' ? jpFontCss : locale === 'ko' ? krFontCss : null;
const site = Astro.site ?? new URL('https://rearrangepdf.com');
const canonical = canonicalPath
  ? new URL(localePath(canonicalPath, locale), site).href
  : new URL(Astro.url.pathname, site).href;
const alternates = canonicalPath && !noindex ? getAlternates(canonicalPath, site) : [];
const ogAlternates = noindex
  ? []
  : Object.values(localeMeta)
      .filter((entry) => entry.code !== locale)
      .map((entry) => entry.ogLocale);
const ogImage = new URL('/og-image.png', site).href;
const ogImageAlt = dict.ogImageAlt;
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonical} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta
        name="robots"
        content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      />
    )}
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {cjkFontCss && <link rel="stylesheet" href={cjkFontCss} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#e8ebe6" id="theme-color" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={dict.siteName} />
    <meta property="og:locale" content={meta.ogLocale} />
    {ogAlternates.map((ogLocale) => (
      <meta property="og:locale:alternate" content={ogLocale} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {schemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    {cfBeaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
      ></script>
    )}
    {/* Resolve the theme before first paint to avoid a flash of the wrong theme.
        Stored preference is `light` | `dark` | `system` (absent = system). */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        const preferDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored === 'light' || stored === 'dark' ? stored : preferDark ? 'dark' : 'light';
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        const meta = document.getElementById('theme-color');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#0d120c' : '#e8ebe6');
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{dict.skipToContent}</a>
    <slot />
    {/* Opt-in scroll reveals. Skipped entirely (content stays visible) under
        reduced motion or where IntersectionObserver is unavailable. */}
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const nodes = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!reduceMotion && nodes.length > 0 && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('reveal-ready');
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );
        nodes.forEach((node) => observer.observe(node));
      }
    </script>
  </body>
</html>
