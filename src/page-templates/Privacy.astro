---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import Icon from '../components/site/Icon.astro';
import RichText from '../components/RichText.astro';
import { getDictionary, localePath, type Locale } from '../i18n/utils';
import { webPageSchemas } from '../i18n/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const site = Astro.site ?? new URL('https://rearrangepdf.com');
const jsonLd = webPageSchemas(t, locale, site, {
  logicalPath: '/privacy',
  name: t.pages.privacy.h1,
  description: t.pages.privacy.meta.description,
  breadcrumb: t.pages.privacy.breadcrumb,
});
---

<Layout
  title={t.pages.privacy.meta.title}
  description={t.pages.privacy.meta.description}
  canonicalPath="/privacy"
  locale={locale}
  jsonLd={jsonLd}
>
  <Nav locale={locale} />
  <main id="main">
    <article class="bg-canvas-soft">
      <div class="container-page py-12 md:py-16 max-w-3xl">
        <nav aria-label={t.breadcrumbAriaLabel} class="text-body-sm text-mute">
          <a href={localePath('/', locale)} class="hover:text-ink transition-colors">{t.breadcrumbHome}</a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page" class="text-body">{t.pages.privacy.breadcrumb}</span>
        </nav>

        <h1 class="mt-4 font-black text-display-sm md:text-display-md">{t.pages.privacy.h1}</h1>
        <p class="mt-3 text-body-sm text-mute">{t.pages.privacy.lastUpdated}</p>

        <div class="mt-8 rounded-xl bg-primary-pale p-6">
          <h2 class="text-display-xs font-semibold">{t.pages.privacy.shortH2}</h2>
          <ul class="mt-3 space-y-2 text-body-md text-body">
            {
              t.pages.privacy.shortItems.map((item) => (
                <li class="flex gap-2.5">
                  <Icon name="check" size={20} class="mt-0.5 shrink-0 text-positive" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        {
          t.pages.privacy.sections.map((section) => (
            <section class="mt-10" data-reveal>
              <h2 class="text-display-xs font-semibold">{section.title}</h2>
              {section.text && (
                <p class="mt-2 text-body-md text-body">
                  <RichText text={section.text} locale={locale} linkClass="font-semibold underline underline-offset-2" />
                </p>
              )}
              {section.bullets && (
                <ul class="mt-2 list-disc space-y-1.5 pl-6 text-body-md text-body">
                  {section.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              )}
              {section.subsections && (
                <div class="mt-2">
                  {section.subsections.map((subsection) => (
                    <div class="mt-4">
                      <h3 class="text-body-lg font-semibold">{subsection.title}</h3>
                      <p class="mt-1 text-body-md text-body">{subsection.text}</p>
                    </div>
                  ))}
                </div>
              )}
            </section>
          ))
        }
      </div>
    </article>
  </main>
  <Footer locale={locale} />
</Layout>
