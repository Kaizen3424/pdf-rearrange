---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import RichText from '../components/RichText.astro';
import { getDictionary, localePath, type Locale } from '../i18n/utils';
import { webPageSchemas } from '../i18n/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const site = Astro.site ?? new URL('https://rearrangepdf.com');
const jsonLd = webPageSchemas(t, locale, site, {
  logicalPath: '/terms',
  name: t.pages.terms.h1,
  description: t.pages.terms.meta.description,
  breadcrumb: t.pages.terms.breadcrumb,
});
---

<Layout
  title={t.pages.terms.meta.title}
  description={t.pages.terms.meta.description}
  canonicalPath="/terms"
  locale={locale}
  jsonLd={jsonLd}
>
  <Nav locale={locale} />
  <main id="main">
    <article class="bg-canvas-soft">
      <div class="container-page py-12 md:py-16 max-w-3xl">
        <nav aria-label={t.breadcrumbAriaLabel} class="text-body-sm text-mute">
          <a href={localePath('/', locale)} class="hover:text-ink transition-colors">{t.breadcrumbHome}</a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page" class="text-body">{t.pages.terms.breadcrumb}</span>
        </nav>

        <h1 class="mt-4 font-black text-display-sm md:text-display-md">{t.pages.terms.h1}</h1>
        <p class="mt-3 text-body-sm text-mute">{t.pages.terms.lastUpdated}</p>

        {
          t.pages.terms.sections.map((section) => (
            <section class="mt-10">
              <h2 class="text-display-xs font-semibold">{section.title}</h2>
              <p class="mt-2 text-body-md text-body">
                <RichText text={section.text} locale={locale} linkClass="font-semibold underline underline-offset-2" />
              </p>
            </section>
          ))
        }
      </div>
    </article>
  </main>
  <Footer locale={locale} />
</Layout>
