---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import Icon from '../components/site/Icon.astro';
import RichText from '../components/RichText.astro';
import { getDictionary, localePath, type Locale } from '../i18n/utils';
import { contactSchemas } from '../i18n/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const site = Astro.site ?? new URL('https://rearrangepdf.com');
const jsonLd = contactSchemas(t, locale, site);

const email = 'kaizen3242@gmail.com';

const helpLinks = [
  { href: localePath('/#faq', locale), icon: 'circle-question', ...t.pages.contact.helpLinks[0]! },
  { href: localePath('/how-to-organize-pdf-pages', locale), icon: 'file-text', ...t.pages.contact.helpLinks[1]! },
  { href: localePath('/privacy', locale), icon: 'shield-check', ...t.pages.contact.helpLinks[2]! },
];
---

<Layout
  title={t.pages.contact.meta.title}
  description={t.pages.contact.meta.description}
  canonicalPath="/contact"
  locale={locale}
  jsonLd={jsonLd}
>
  <Nav locale={locale} />
  <main id="main">
    <article class="bg-canvas-soft">
      <div class="container-page py-12 md:py-16 max-w-3xl">
        <nav aria-label={t.breadcrumbAriaLabel} class="text-body-sm text-mute">
          <a href={localePath('/', locale)} class="hover:text-ink transition-colors">{t.breadcrumbHome}</a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page" class="text-body">{t.pages.contact.breadcrumb}</span>
        </nav>

        <h1 class="mt-4 font-black text-display-sm md:text-display-md">{t.pages.contact.h1}</h1>
        <p class="mt-5 text-body-lg text-body">
          {t.pages.contact.intro}
        </p>

        <div class="mt-8 rounded-xl bg-primary-pale p-6">
          <h2 class="text-display-xs font-semibold">{t.pages.contact.emailH2}</h2>
          <p class="mt-2 text-body-md text-body">
            {t.pages.contact.emailP}
          </p>
          <a
            href={`mailto:${email}`}
            class="btn btn-primary mt-5"
          >
            <Icon name="file-text" size={18} />
            {email}
          </a>
        </div>

        <h2 class="mt-10 text-display-xs font-semibold">{t.pages.contact.beforeH2}</h2>
        <p class="mt-2 text-body-md text-body">
          {t.pages.contact.beforeP}
        </p>
        <ul class="mt-4 space-y-2.5 text-body-md text-body">
          {
            t.pages.contact.beforeItems.map((item) => (
              <li class="flex gap-2.5">
                <Icon name="check" size={20} class="mt-0.5 shrink-0 text-positive" />
                <span>
                  <RichText text={item} locale={locale} />
                </span>
              </li>
            ))
          }
        </ul>

        <h2 class="mt-10 text-display-xs font-semibold">{t.pages.contact.answersH2}</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          {
            helpLinks.map((link) => (
              <a
                href={link.href}
                class="group rounded-xl border border-ink/10 bg-canvas p-5 transition-colors hover:border-ink/25 focus-ring"
              >
                <Icon name={link.icon} size={22} class="text-ink" />
                <h3 class="mt-3 text-body-md-strong">{link.title}</h3>
                <p class="mt-1 text-body-sm text-mute">{link.body}</p>
              </a>
            ))
          }
        </div>

        <h2 class="mt-10 text-display-xs font-semibold">{t.pages.contact.dataH2}</h2>
        <p class="mt-2 text-body-md text-body">
          <RichText
            text={t.pages.contact.dataP}
            locale={locale}
            linkClass="font-semibold underline underline-offset-2"
          />
        </p>

        <div class="mt-12 rounded-xl bg-solid p-8 text-center">
          <h2 class="font-black text-display-sm text-on-solid">{t.pages.contact.ctaH2}</h2>
          <p class="mt-2 text-body-md text-on-solid/80">
            {t.pages.contact.ctaP}
          </p>
          <a href={localePath('/#rearrange', locale)} class="btn btn-primary mt-6">
            {t.pages.contact.ctaButton}
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </article>
  </main>
  <Footer locale={locale} />
</Layout>
