---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import Icon from '../components/site/Icon.astro';
import PrivacySection from '../components/site/PrivacySection.astro';
import CtaSection from '../components/site/CtaSection.astro';
import { getDictionary, localePath, type Locale } from '../i18n/utils';
import { getToolsWithContent } from '../content/tools';
import { toolsHubSchemas } from '../i18n/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const site = Astro.site ?? new URL('https://rearrangepdf.com');
const tools = getToolsWithContent(locale);
const jsonLd = toolsHubSchemas(tools, locale, site);
---

<Layout
  title={t.tools.meta.title}
  description={t.tools.meta.description}
  canonicalPath="/tools"
  locale={locale}
  jsonLd={jsonLd}
>
  <Nav locale={locale} />
  <main id="main">
    <section class="bg-canvas border-b border-hairline">
      <div class="container-page pt-10 pb-14 md:pt-14 md:pb-20">
        <nav aria-label={t.breadcrumbAriaLabel} class="text-body-sm text-mute">
          <a href={localePath('/', locale)} class="hover:text-ink transition-colors">
            {t.breadcrumbHome}
          </a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page" class="text-body">{t.tools.breadcrumb}</span>
        </nav>

        <div class="mt-6 flex max-w-3xl flex-col gap-4">
          <h1 class="font-black text-display-sm md:text-display-md">{t.tools.h1}</h1>
          <p class="text-body-lg text-body">{t.tools.intro}</p>
        </div>
      </div>
    </section>

    <section class="bg-canvas-soft">
      <div class="container-page py-16 md:py-20">
        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            tools.map(({ tool, content }, index) => (
              <li data-reveal style={`--reveal-delay:${index * 50}ms`}>
                <a
                  href={localePath(`/${tool.slug}`, locale)}
                  class="group flex h-full flex-col rounded-xl bg-canvas p-6 md:p-7 transition-[transform,box-shadow] duration-200 ease-standard hover:-translate-y-1 hover:elev-2"
                >
                  <span class="flex size-11 items-center justify-center rounded-md bg-solid text-primary">
                    <Icon name={tool.icon} size={22} />
                  </span>
                  <h2 class="mt-5 text-display-xs font-semibold text-ink">{content.h1}</h2>
                  <p class="mt-2 grow text-body-md text-body">{content.meta.description}</p>
                  <span class="mt-5 inline-flex items-center gap-2 text-body-sm-strong text-ink">
                    {t.tools.cardCta}
                    <Icon
                      name="arrow-right"
                      size={16}
                      class="shrink-0 text-mute transition-transform duration-200 ease-out-expo group-hover:translate-x-1"
                    />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <div
          class="mt-14 rounded-xl bg-solid p-8 text-center ring-1 ring-inset ring-white/5 md:p-10"
          data-reveal
        >
          <h2 class="font-black text-display-sm text-on-solid">{t.tools.allInOneTitle}</h2>
          <p class="mx-auto mt-3 max-w-xl text-body-md text-on-solid/80">{t.tools.allInOneBody}</p>
          <a href={localePath('/#rearrange', locale)} class="btn btn-primary mt-7 group">
            {t.tools.allInOneCta}
            <Icon
              name="arrow-right"
              size={18}
              class="transition-transform duration-200 ease-out-expo group-hover:translate-x-1"
            />
          </a>
        </div>
      </div>
    </section>

    <PrivacySection locale={locale} />
    <CtaSection locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
