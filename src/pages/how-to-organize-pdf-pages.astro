---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import Icon from '../components/site/Icon.astro';

const title = 'How to Organize PDF Pages Online for Free (No Uploads) — Step-by-Step Guide';
const description =
  'Learn how to rearrange, reorder and organize PDF pages in any browser — free and with no uploads. Covers desktop and mobile, merging files, reversing order, replacing pages and more.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to organize PDF pages online for free',
    description:
      'A step-by-step guide to rearranging PDF pages in your browser without uploading the file anywhere.',
    totalTime: 'PT2M',
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Open the tool and add your PDF',
        text: 'Go to rearrangepdf.com and drop your PDF onto the tool, click "Select PDF file", or paste the file with Ctrl+V.',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Drag pages into the new order',
        text: 'Drag any page thumbnail to a new position. Use the hover buttons or selection toolbar to rotate, duplicate or delete pages.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Download the organized PDF',
        text: 'Click "Download PDF" — the file is rebuilt on your device and saved immediately, with no watermark.',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Rearrange PDF',
        item: 'https://rearrangepdf.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'How to organize PDF pages',
        item: 'https://rearrangepdf.com/how-to-organize-pdf-pages',
      },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  canonicalPath="/how-to-organize-pdf-pages"
  ogType="article"
  jsonLd={jsonLd}
>
  <Nav />
  <main id="main">
    <article class="bg-canvas-soft">
      <div class="container-page py-12 md:py-16 max-w-3xl">
        <nav aria-label="Breadcrumb" class="text-body-sm text-mute">
          <a href="/" class="hover:text-ink transition-colors">Home</a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page" class="text-body">How to organize PDF pages</span>
        </nav>

        <h1 class="mt-4 font-black text-display-sm md:text-display-md">
          How to organize PDF pages online for free
        </h1>
        <p class="mt-4 text-body-lg text-body">
          Scanned your document back-to-front? Appendix landing before the introduction? Here is
          the fastest way to fix the page order of any PDF — without uploading it to anyone's
          server, creating an account, or hitting a "free trial" wall.
        </p>

        <div class="mt-8 rounded-xl bg-primary-pale p-6">
          <h2 class="text-display-xs font-semibold">The quick answer</h2>
          <ol class="mt-4 space-y-3 text-body-md text-body">
            <li class="flex gap-3">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-ink text-caption font-bold text-primary">1</span>
              <span><a href="/#rearrange" class="font-semibold underline underline-offset-2">Open the tool</a> and drop your PDF on it.</span>
            </li>
            <li class="flex gap-3">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-ink text-caption font-bold text-primary">2</span>
              <span>Drag the page thumbnails into the order you want.</span>
            </li>
            <li class="flex gap-3">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-ink text-caption font-bold text-primary">3</span>
              <span>Click <strong>Download PDF</strong> — done, no watermark.</span>
            </li>
          </ol>
        </div>

        <h2 class="mt-12 text-display-sm font-semibold">Step-by-step: rearranging pages in detail</h2>

        <h3 class="mt-6 text-display-xs font-semibold">Step 1 — Add your PDF</h3>
        <p class="mt-2 text-body-md text-body">
          Drag the file from your desktop or file manager straight onto the upload card, or click
          it to browse. You can also copy a PDF and paste it with
          <strong>Ctrl+V</strong> (⌘V on Mac). Want to combine documents first? Drop several PDFs
          at once — their pages merge into a single grid, each file marked with its own color, so
          you can then interleave pages from all of them.
        </p>

        <h3 class="mt-6 text-display-xs font-semibold">Step 2 — Drag pages into order</h3>
        <p class="mt-2 text-body-md text-body">
          Every page shows as a thumbnail. Grab one and drag it where it belongs — the others make
          room as you go. On a phone or tablet, press and hold a page briefly to lift it, then
          drag.
        </p>
        <p class="mt-2 text-body-md text-body">
          Hovering a page reveals small buttons to
          <strong>rotate</strong> (fix sideways scans), <strong>duplicate</strong>,
          <strong>preview</strong> full-size, or <strong>delete</strong>. Click pages to select
          several at once — or <strong>Ctrl+A</strong> to select all — then rotate or delete them
          in one batch from the toolbar that appears.
        </p>

        <h3 class="mt-6 text-display-xs font-semibold">Step 3 — Download your organized PDF</h3>
        <p class="mt-2 text-body-md text-body">
          Hit <strong>Download PDF</strong>. The file is rebuilt on your device — the exact
          original pages, just in your chosen order — and saved straight to your downloads folder.
          No watermark, no email required, no queue.
        </p>

        <h2 class="mt-12 text-display-sm font-semibold">Useful tricks worth knowing</h2>
        <ul class="mt-4 space-y-4 text-body-md text-body">
          <li class="flex gap-3">
            <Icon name="undo-2" size={20} class="mt-0.5 shrink-0 text-ink" />
            <span><strong>Nothing is permanent.</strong> Every action is undoable with Ctrl+Z, redoable with Ctrl+Shift+Z. Experiment freely — the one-click "restore original order" button takes the whole document back to how it started.</span>
          </li>
          <li class="flex gap-3">
            <Icon name="layers" size={20} class="mt-0.5 shrink-0 text-ink" />
            <span><strong>Reverse a whole document</strong> with the reverse-order button in the toolbar — handy for scans made back-to-front, no dragging required.</span>
          </li>
          <li class="flex gap-3">
            <Icon name="file-plus" size={20} class="mt-0.5 shrink-0 text-ink" />
            <span><strong>Replace a page:</strong> delete the outdated page, click "Add PDFs" to bring in the replacement, then drag it into position.</span>
          </li>
          <li class="flex gap-3">
            <Icon name="plus" size={20} class="mt-0.5 shrink-0 text-ink" />
            <span><strong>Insert a blank page</strong> anywhere — useful for notes or print separators — with the "+" button in the toolbar.</span>
          </li>
          <li class="flex gap-3">
            <Icon name="layout-grid" size={20} class="mt-0.5 shrink-0 text-ink" />
            <span><strong>Keep only what you need:</strong> select the pages you want to keep, invert nothing — simply delete the rest, and download the trimmed document.</span>
          </li>
          <li class="flex gap-3">
            <Icon name="maximize-2" size={20} class="mt-0.5 shrink-0 text-ink" />
            <span><strong>Check before you commit:</strong> open any page full-size with the preview button and flip through the document with the arrow keys before downloading.</span>
          </li>
        </ul>

        <h2 class="mt-12 text-display-sm font-semibold">Rearranging PDF pages on mobile</h2>
        <p class="mt-3 text-body-md text-body">
          The editor is designed touch-first: thumbnails are large, action buttons sit within
          thumb's reach, and dragging works with a short press-and-hold. Tap pages to select them
          for batch rotate or delete. On iOS or Android, you can open a PDF from your Files or
          Drive app, share it to the browser, and rearrange it right there.
        </p>

        <h2 class="mt-12 text-display-sm font-semibold">Why rearranging locally matters</h2>
        <p class="mt-3 text-body-md text-body">
          Most "free" PDF organizers upload your file to a processing server, then promise to
          delete it later. That's fine until it isn't — contracts, medical records and financial
          statements deserve better. This tool does all the work inside your browser tab: your PDF
          is read into memory, displayed, and written back out without a single byte leaving your
          device. You don't have to take our word for it — open your browser's developer tools,
          watch the network tab, and rearrange away.
        </p>

        <div class="mt-12 rounded-xl bg-ink p-8 text-center">
          <h2 class="font-black text-display-sm text-canvas">Ready to fix your page order?</h2>
          <p class="mt-2 text-body-md text-canvas-soft/80">
            Free, unlimited, no sign-up — and your file never leaves the browser.
          </p>
          <a href="/#rearrange" class="btn btn-primary mt-6">
            Rearrange a PDF now
            <Icon name="arrow-right" size={18} />
          </a>
        </div>

        <p class="mt-8 text-body-sm text-mute">
          Looking for more answers? See the full
          <a href="/#faq" class="underline underline-offset-2 hover:text-ink">FAQ on the home page</a>.
        </p>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
