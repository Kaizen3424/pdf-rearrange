---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import ErrorPage from '../components/site/ErrorPage.astro';

const title = 'Page not found — Rearrange PDF';
const description = 'That page does not exist. Head back to rearrange your PDF pages.';
---

<Layout title={title} description={description} canonicalPath="/404" noindex>
  <Nav />
  <main id="main">
    <ErrorPage
      code="404"
      heading="This page took a wrong turn."
      message="The page you're looking for doesn't exist — but your PDF's page order can still be fixed in seconds."
    />
  </main>
  <Footer />
</Layout>
