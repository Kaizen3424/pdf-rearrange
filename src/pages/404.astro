---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import ErrorPage from '../components/site/ErrorPage.astro';
import { getDictionary } from '../i18n/utils';

const t = getDictionary('en');
---

<Layout title={t.errors.notFound.title} description={t.errors.notFound.description} canonicalPath="/404" noindex>
  <Nav />
  <main id="main">
    <ErrorPage
      code="404"
      heading={t.errors.notFound.heading}
      message={t.errors.notFound.message}
      backToToolLabel={t.errors.backToTool}
    />
  </main>
  <Footer />
</Layout>
