---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import ErrorPage from '../components/site/ErrorPage.astro';
import { getDictionary } from '../i18n/utils';

interface Props {
  error?: unknown;
}

const t = getDictionary('en');
---

<Layout title={t.errors.serverError.title} description={t.errors.serverError.description} canonicalPath="/500" noindex>
  <Nav />
  <main id="main">
    <ErrorPage
      code="500"
      heading={t.errors.serverError.heading}
      message={t.errors.serverError.message}
      reload
      tryAgainLabel={t.errors.tryAgain}
      backToToolLabel={t.errors.backToTool}
    />
  </main>
  <Footer />
</Layout>
