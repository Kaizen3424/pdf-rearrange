---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/site/Nav.astro';
import Hero from '../components/site/Hero.astro';
import HowItWorks from '../components/site/HowItWorks.astro';
import Features from '../components/site/Features.astro';
import PrivacySection from '../components/site/PrivacySection.astro';
import Faq from '../components/site/Faq.astro';
import SeoContent from '../components/site/SeoContent.astro';
import CtaSection from '../components/site/CtaSection.astro';
import Footer from '../components/site/Footer.astro';
import OrganizeTool from '../components/organize/OrganizeTool';
import { faqs } from '../data/faqs';

const title = 'Rearrange PDF Pages Online Free — Merge, Reorder & Delete Pages | Rearrange PDF';
const description =
  'Rearrange PDF pages online free. Drag and drop to reorder, merge, combine or delete pages — 100% private, no uploads, no limits, no sign-up, no watermark.';

const keywords = [
  'rearrange pdf',
  'rearrange pdf pages',
  'rearrange pdf pages free',
  'rearrange pdf pages online',
  'rearrange pdf pages online free',
  'rearrange pdf online',
  'rearrange pdf free',
  'merge and rearrange pdf',
  'combine and rearrange pdf',
  'delete and rearrange pdf pages',
  'how to rearrange pdf pages',
  'how to rearrange pdf pages online free',
  'how to rearrange pdf pages on iphone',
  'what are the best ways to rearrange pdf pages',
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Rearrange PDF',
    alternateName: 'Rearrange PDF Pages',
    url: 'https://rearrangepdf.com/',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any (web browser)',
    browserRequirements: 'Requires JavaScript. Works in all modern browsers.',
    description:
      'Free online tool to rearrange, reorder, rotate, duplicate and delete PDF pages entirely in your browser. No uploads, no limits, no sign-up.',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    featureList: [
      'Drag-and-drop page reordering',
      'Rotate, duplicate and delete pages',
      'Merge multiple PDFs and reorder the combined document',
      'Add blank pages',
      'Multi-select with batch actions',
      'Undo and redo history',
      'Keyboard shortcuts',
      'Page preview',
      '100% client-side processing — files never leave the browser',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to rearrange pages in a PDF',
    description:
      'Rearrange the pages of any PDF in three steps, entirely in your browser with no uploads.',
    totalTime: 'PT1M',
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Add your PDF',
        text: 'Drop a PDF file on the tool, click to browse, or paste one in. You can add several PDFs at once to merge them.',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Arrange your pages',
        text: 'Drag page thumbnails into the order you want. Rotate, duplicate or delete pages as needed — everything can be undone.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Download instantly',
        text: 'Click Download PDF. Your rearranged file is rebuilt on your device and saved with no watermark.',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Rearrange PDF',
    url: 'https://rearrangepdf.com/',
    logo: 'https://rearrangepdf.com/logo.png',
    email: 'kaizen3242@gmail.com',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Rearrange PDF',
    url: 'https://rearrangepdf.com/',
  },
];
---

<Layout title={title} description={description} keywords={keywords} jsonLd={jsonLd}>
  <Nav />
  <main id="main">
    <Hero>
      <OrganizeTool client:load />
    </Hero>
    <HowItWorks />
    <Features />
    <PrivacySection />
    <Faq />
    <SeoContent />
    <CtaSection />
  </main>
  <Footer />
</Layout>
