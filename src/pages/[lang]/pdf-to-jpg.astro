---
import ToolPage from '../../page-templates/ToolPage.astro';
import { defaultLocale, isLocale, localeStaticPaths, type Locale } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths('/pdf-to-jpg');
}

const { lang } = Astro.params;
const locale: Locale = isLocale(lang) ? lang : defaultLocale;
---

<ToolPage locale={locale} slug="pdf-to-jpg" />