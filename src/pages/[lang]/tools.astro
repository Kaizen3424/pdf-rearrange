---
import Tools from '../../page-templates/Tools.astro';
import { defaultLocale, isLocale, localeStaticPaths, type Locale } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths('/tools');
}

const { lang } = Astro.params;
const locale: Locale = isLocale(lang) ? lang : defaultLocale;
---

<Tools locale={locale} />