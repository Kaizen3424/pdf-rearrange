---
import Home from '../../page-templates/Home.astro';
import { defaultLocale, isLocale, localeStaticPaths, type Locale } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.params;
const locale: Locale = isLocale(lang) ? lang : defaultLocale;
---

<Home locale={locale} />
