---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import Icon from '../components/site/Icon.astro';

const title = 'Contact — Rearrange PDF';
const description =
  'Get in touch with the team behind Rearrange PDF. Report a file that does not work, suggest a feature, or ask a question about the browser-based PDF page organizer.';

const email = 'kaizen3242@gmail.com';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact Rearrange PDF',
    description:
      'Contact details for Rearrange PDF, the browser-based tool for rearranging and organizing PDF pages without uploading.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Rearrange PDF',
        item: 'https://rearrangepdf.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Contact',
        item: 'https://rearrangepdf.com/contact',
      },
    ],
  },
];

const helpLinks = [
  {
    href: '/#faq',
    icon: 'circle-question',
    title: 'Read the FAQ',
    body: 'Quick answers about uploads, file size, page quality and privacy.',
  },
  {
    href: '/how-to-organize-pdf-pages',
    icon: 'file-text',
    title: 'Open the guide',
    body: 'Step-by-step instructions for reordering, rotating and deleting pages.',
  },
  {
    href: '/privacy',
    icon: 'shield-check',
    title: 'Review our privacy policy',
    body: 'Exactly what the tool does — and does not — do with your files.',
  },
];
---

<Layout
  title={title}
  description={description}
  canonicalPath="/contact"
  jsonLd={jsonLd}
>
  <Nav />
  <main id="main">
    <article class="bg-canvas-soft">
      <div class="container-page py-12 md:py-16 max-w-3xl">
        <nav aria-label="Breadcrumb" class="text-body-sm text-mute">
          <a href="/" class="hover:text-ink transition-colors">Home</a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page" class="text-body">Contact</span>
        </nav>

        <h1 class="mt-4 font-black text-display-sm md:text-display-md">Contact us</h1>
        <p class="mt-5 text-body-lg text-body">
          Found a PDF that will not open? Have an idea that would make the tool better? We read
          every message and genuinely appreciate the feedback.
        </p>

        <div class="mt-8 rounded-xl bg-primary-pale p-6">
          <h2 class="text-display-xs font-semibold">Email us</h2>
          <p class="mt-2 text-body-md text-body">
            The fastest way to reach us is by email. We are a small team, so please allow a couple
            of days for a reply.
          </p>
          <a
            href={`mailto:${email}`}
            class="btn btn-primary mt-5"
          >
            <Icon name="file-text" size={18} />
            {email}
          </a>
        </div>

        <h2 class="mt-10 text-display-xs font-semibold">Before you write</h2>
        <p class="mt-2 text-body-md text-body">
          A few notes help us help you faster:
        </p>
        <ul class="mt-4 space-y-2.5 text-body-md text-body">
          <li class="flex gap-2.5">
            <Icon name="check" size={20} class="mt-0.5 shrink-0 text-positive" />
            <span>
              <strong>Tell us which file misbehaved.</strong> If a PDF fails to load or export,
              describe the document type (scanned, form, encrypted, very large) rather than sending
              the file.
            </span>
          </li>
          <li class="flex gap-2.5">
            <Icon name="check" size={20} class="mt-0.5 shrink-0 text-positive" />
            <span>
              <strong>We cannot see your files.</strong> The tool runs entirely in your browser, so
              your PDFs never reach us. Please do not email sensitive documents — a description is
              all we need.
            </span>
          </li>
          <li class="flex gap-2.5">
            <Icon name="check" size={20} class="mt-0.5 shrink-0 text-positive" />
            <span>
              <strong>Include your browser and device</strong> (for example, "Safari on iPhone") if
              you are reporting a problem — it helps us reproduce it.
            </span>
          </li>
        </ul>

        <h2 class="mt-10 text-display-xs font-semibold">You might find the answer right here</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          {
            helpLinks.map((link) => (
              <a
                href={link.href}
                class="group rounded-xl border border-ink/10 bg-canvas p-5 transition-colors hover:border-ink/25 focus-ring"
              >
                <Icon name={link.icon} size={22} class="text-ink" />
                <h3 class="mt-3 text-body-md-strong">{link.title}</h3>
                <p class="mt-1 text-body-sm text-mute">{link.body}</p>
              </a>
            ))
          }
        </div>

        <h2 class="mt-10 text-display-xs font-semibold">About your data</h2>
        <p class="mt-2 text-body-md text-body">
          Because we do not collect personal data, there is usually nothing for us to look up on
          your behalf — but if you have a privacy question, we are happy to answer it. See our
          <a href="/privacy" class="font-semibold underline underline-offset-2">privacy policy</a>
          and
          <a href="/terms" class="font-semibold underline underline-offset-2">terms of service</a>
          for the full details.
        </p>

        <div class="mt-12 rounded-xl bg-ink p-8 text-center">
          <h2 class="font-black text-display-sm text-canvas">Need to fix a PDF right now?</h2>
          <p class="mt-2 text-body-md text-canvas-soft/80">
            The tool is free, unlimited — and nothing ever leaves your browser.
          </p>
          <a href="/#rearrange" class="btn btn-primary mt-6">
            Rearrange a PDF
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
