# Copy this file to `.env` and fill in values to enable optional integrations.
# `.env` is gitignored; never commit real tokens.

# Cloudflare Web Analytics beacon token (Cloudflare dashboard → Web Analytics).
# When set, the cookieless beacon is emitted on every page and its origin is
# automatically allowed in the Content Security Policy. Leave empty to omit it.
PUBLIC_CF_BEACON_TOKEN=
